/*
 * Linker glue for maplesu_ir. These are the four objects the kernel module
 * loader looks for by name and that kbuild's modpost would normally generate.
 * They are written out here instead of generated, because this module is built
 * without a kernel tree (see build_ir_module.py) and every byte of the layout
 * must be checked against the target kernel's own BTF rather than assumed.
 *
 * Layout facts (asserted by build_ir_module.py against contract.json):
 *   sizeof(struct module) == 1536 (0x600), name at +0x18 (char[56]),
 *   init at +0x188, exit at +0x5b8, arch at +0x3b8 (all-zero MODULE_ARCH_INIT).
 *
 * @IR_MODULE_NAME@, @IR_DESCRIPTION@, @IR_LICENSE@ and @IR_VERMAGIC@ are
 * substituted by the builder; the template is a .in file so the substitution
 * edge stays visible and reviewable.
 */

	.section .modinfo,"a",@progbits
.Lmodinfo:
	.asciz "license=@IR_LICENSE@"
	.asciz "description=@IR_DESCRIPTION@"
	.asciz "vermagic=@IR_VERMAGIC@"
	.asciz "name=@IR_MODULE_NAME@"
	.asciz "depends="
	.balign 1

/*
 * The four sections arm64's module finalizer insists on.
 *
 * `module_init_plt()` looks up `.plt` and `.init.plt` and returns -ENOEXEC with
 * "module PLT section(s) missing" when either is absent - which is exactly how every
 * earlier build of this module was refused, with nothing in our own log to show for
 * it. They are one byte each, as kbuild emits them: the PLT allocator only ever
 * appends entries when a CALL26 is out of range, and ours never are. kbuild's module
 * linker script also creates `.text.ftrace_trampoline`; it is carried for parity and
 * is never written unless ftrace asks for a trampoline.
 */
	.section .plt,"ax",@progbits
	.balign 1
	.byte 0
	.section .init.plt,"ax",@progbits
	.balign 1
	.byte 0
	.section .text.ftrace_trampoline,"ax",@progbits
	.balign 1
	.byte 0

/*
 * struct modversion_info[1], deliberately EMPTY-NAMED.
 *
 * The loader refuses a module with no __versions section at all: check_version()
 * then falls back to try_to_force_load(), and CONFIG_MODULE_FORCE_LOAD is not
 * set on these GKI kernels, so the load fails with -ENOEXEC. With the section
 * present but no entry named "module_layout", check_version() logs
 * "no symbol version for module_layout" and accepts the module, which is the
 * same outcome the vendor dfroot modules rely on (their __versions is 0 bytes).
 * The name field is all zeros, so it can never match a real symbol name.
 */
	.section __versions,"a",@progbits
	.balign 8
	.zero 64

/*
 * struct module __this_module.
 *
 * A zero-filled object of the exact size, with the module name written in place
 * and a relocation each for .init and .exit. The loader fills everything else in
 * (state, list, mkobj, syms, mem[], ...); it only reads name, init and arch from
 * us. Because the size matches the target build exactly, no loader write lands
 * outside the object.
 */
	.section .gnu.linkonce.this_module,"aw",@progbits
	.balign 64
	.globl __this_module
__this_module:
	/* +0x000 struct module starts: state, list */
	.zero 0x18
	/* +0x018 char name[MODULE_NAME_LEN=56] */
	.asciz "@IR_MODULE_NAME@"
	.zero (0x50 - 0x18 - 1 - @IR_MODULE_NAME_LENGTH@)
	/* +0x050 build_id .. +0x188 */
	.zero (0x188 - 0x50)
	/* +0x188 int (*init)(void) */
	.quad init_module
	/* +0x190 .. +0x5b8 */
	.zero (0x5b8 - 0x190)
	/* +0x5b8 void (*exit)(void) */
	.quad cleanup_module
	/* +0x5c0 .. +0x600 */
	.zero (0x600 - 0x5c0)
	.size __this_module, 0x600
	.type __this_module, %object

/*
 * The per-release patch spec, replaced in the .ko before finit_module().
 *
 * Kept as plain text on purpose: the very same bytes are what verify_spec.py
 * checks against a kernel image offline and what the module parses in-kernel, so
 * there is exactly one representation of a release's patch set in the product.
 * The placeholder carries no blocks, so an unpatched module fails closed with
 * IR_ERR_SPEC instead of patching the wrong offsets.
 */
	.section .ir_spec,"aw",@progbits
	.balign 8
	.globl __ir_spec
__ir_spec:
	.asciz "#maplesu-ir-spec v1 placeholder: no blocks; replace before finit_module"
	.zero (4096 - (. - __ir_spec))
	.size __ir_spec, 4096
	.type __ir_spec, %object
