<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Package visibility (Android 11+): without this declaration
        getPackageInfo("dev.maplesu.manager") throws NameNotFoundException, so the
        client cannot verify the Manager's signature and fails closed with
        SU_MANAGER_NOT_INSTALLED. Every integrating app needs the same entry; the
        cooperative entry deliberately does not ask for QUERY_ALL_PACKAGES.
    -->
    <queries>
        <package android:name="dev.maplesu.manager" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/app_name">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
