diff --git a/kernel/compat/samsung_kdp.c b/kernel/compat/samsung_kdp.c
new file mode 100644
index 0000000..2311ed7
--- /dev/null
+++ b/kernel/compat/samsung_kdp.c
@@ -0,0 +1,31 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* MapleSU Samsung KDP channel. Macro set is MapleSU's own (CONFIG_KSU_SAMSUNG_KDP);
+ * do not copy KernelSU-Next/SukiSU macro spellings into this tree. */
+#include <linux/kprobes.h>
+#include <linux/module.h>
+#include "samsung_kdp.h"
+#include "klog.h"
+
+#ifdef CONFIG_KSU_SAMSUNG_KDP
+#define MAPLESU_SAMSUNG_KDP_PROBE "kdp_memory_guard"
+static struct kprobe maplesu_samsung_kdp_probe = {
+    .symbol_name = MAPLESU_SAMSUNG_KDP_PROBE,
+};
+
+int ksu_samsung_kdp_init(void)
+{
+    int ret = register_kprobe(&maplesu_samsung_kdp_probe);
+    if (ret) {
+        pr_err("MAPLESU_SAMSUNG_KDP: probe %s registration failed: %d\n",
+               MAPLESU_SAMSUNG_KDP_PROBE, ret);
+        return ret;
+    }
+    pr_info("MAPLESU_SAMSUNG_KDP: channel ready (probe=%s)\n", MAPLESU_SAMSUNG_KDP_PROBE);
+    return 0;
+}
+
+void ksu_samsung_kdp_exit(void)
+{
+    unregister_kprobe(&maplesu_samsung_kdp_probe);
+}
+#endif
diff --git a/kernel/compat/samsung_kdp.h b/kernel/compat/samsung_kdp.h
new file mode 100644
index 0000000..950ad75
--- /dev/null
+++ b/kernel/compat/samsung_kdp.h
@@ -0,0 +1,12 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* MapleSU Samsung delta: KDP protected-memory read/write channel (tree-local names). */
+#ifndef MAPLESU_SAMSUNG_KDP_H
+#define MAPLESU_SAMSUNG_KDP_H
+#ifdef CONFIG_KSU_SAMSUNG_KDP
+int ksu_samsung_kdp_init(void);
+void ksu_samsung_kdp_exit(void);
+#else
+static inline int ksu_samsung_kdp_init(void) { return 0; }
+static inline void ksu_samsung_kdp_exit(void) { }
+#endif
+#endif
