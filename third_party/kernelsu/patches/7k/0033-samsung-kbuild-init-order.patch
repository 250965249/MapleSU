diff --git a/kernel/Kbuild b/kernel/Kbuild
index 3e05ba1..d78fec8 100644
--- a/kernel/Kbuild
+++ b/kernel/Kbuild
@@ -1,5 +1,8 @@
 kernelsu-objs := core/init.o

+kernelsu-objs += compat/samsung_kdp.o
+kernelsu-objs += compat/samsung_defex.o
+
 kernelsu-objs += feature/kernel_umount.o
 kernelsu-objs += feature/module_blacklist.o
 kernelsu-objs += feature/sulog.o
@@ -244,3 +247,13 @@ ccflags-y += -Wno-strict-prototypes -Wno-int-conversion -Wno-gcc-compat -Wno-mis
 ccflags-y += -Wno-declaration-after-statement -Wno-unused-function

 # Keep a new line here!! Because someone may append config
+
+ifeq ($(CONFIG_KSU_RKP_NO_PATCH_TEXT),y)
+ccflags-y += -DCONFIG_KSU_RKP_NO_PATCH_TEXT=1
+endif
+ifeq ($(CONFIG_KSU_SAMSUNG_KDP),y)
+ccflags-y += -DCONFIG_KSU_SAMSUNG_KDP=1
+endif
+ifeq ($(CONFIG_KSU_SAMSUNG_DEFEX),y)
+ccflags-y += -DCONFIG_KSU_SAMSUNG_DEFEX=1
+endif
diff --git a/kernel/core/init.c b/kernel/core/init.c
index 81f3b65..c856bc9 100644
--- a/kernel/core/init.c
+++ b/kernel/core/init.c
@@ -8,6 +8,7 @@
 #include <linux/moduleparam.h>

 #include "policy/allowlist.h"
+#include "ksu_samsung_kdp.h"
 #include "policy/app_profile.h"
 #include "policy/feature.h"
 #include "klog.h" // IWYU pragma: keep
@@ -28,6 +29,7 @@
 #include "feature/module_blacklist.h"
 #include "feature/shell_su_adb_only.h"
 #include "infra/symbol_resolver.h"
+#include "compat/samsung_defex.h"
 #include "preinit/preinit.h"

 #if defined(__x86_64__) && !defined(CONFIG_KSU_X86_PATCH_SYSCALL_DISPATCHER)
@@ -131,22 +133,41 @@ int __init kernelsu_init(void)
         pr_alert("shell is allowed at init!");
     }

+    ksu_init_symbol_resolver();
+
+#ifdef CONFIG_KSU_SAMSUNG_KDP
+    pr_info("Samsung KDP credential reference handling enabled\n");
+#endif
+    ret = ksu_samsung_kdp_init();
+    if (ret)
+        return ret;
+
     ksu_cred = prepare_creds();
     if (!ksu_cred) {
         pr_err("prepare cred failed!\n");
+        ksu_samsung_kdp_exit();
         return -ENOSYS;
     }

-    pr_info("initializing symbol resolver\n");
-    ksu_init_symbol_resolver();
+    ret = ksu_samsung_defex_init();
+    if (ret) {
+        ksu_put_cred(ksu_cred);
+        ksu_samsung_kdp_exit();
+        return ret;
+    }

     ret = ksu_selinux_inode_init();
     if (ret) {
-        put_cred(ksu_cred);
+        ksu_put_cred(ksu_cred);
         ksu_cred = NULL;
+        ksu_samsung_defex_exit();
+        ksu_samsung_kdp_exit();
         return ret;
     }

+    /* Samsung targets build with CONFIG_KSU_RKP_NO_PATCH_TEXT: text patching
+     * is compiled out, the dispatcher slot never installs, and the hook
+     * manager registers the Samsung sucompat kprobe fallback. */
     ksu_syscall_hook_init();

     // Block modules early, before vendor modules are loaded in second stage.
@@ -245,7 +266,9 @@ void __exit kernelsu_exit(void)
     ksu_feature_exit();
     ksu_module_blacklist_exit();

-    put_cred(ksu_cred);
+    ksu_samsung_defex_exit();
+    ksu_put_cred(ksu_cred);
+    ksu_samsung_kdp_exit();
 }

 #if NEED_OWN_STACKPROTECTOR
