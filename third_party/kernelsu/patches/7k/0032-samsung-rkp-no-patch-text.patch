index 0000000..019d4a9
--- /dev/null
+++ b/kernel/hook/samsung_rkp_guard.c
@@ -0,0 +1,13 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* MapleSU Samsung RKP guard: when CONFIG_KSU_RKP_NO_PATCH_TEXT is set, every kernel
+ * text patch call site must early-return instead of touching read-only text (RKP would panic). */
+#include <linux/kprobes.h>
+#include "klog.h"
+
+#ifdef CONFIG_KSU_RKP_NO_PATCH_TEXT
+int maplesu_rkp_no_patch_text(void)
+{
+    pr_warn("MAPLESU_RKP_NO_PATCH_TEXT: kernel text patching disabled for this build\n");
+    return -EOPNOTSUPP;
+}
+#endif
