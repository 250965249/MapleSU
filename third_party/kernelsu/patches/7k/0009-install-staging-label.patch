@@ -60,6 +60,12 @@ fn restore_syscon_if_unlabeled<P: AsRef<Path>>(dir: P) -> Result<()> {
 
 pub fn restorecon() -> Result<()> {
     lsetfilecon(defs::DAEMON_PATH, KSU_CON)?;
+    // MapleSU W12b: 若上次 install 是 stage_for_switch 且标签被推迟，这里补完后清标记
+    let pending = Path::new(defs::WORKING_DIR).join(".pending_label");
+    if pending.exists() {
+        let _ = std::fs::remove_file(&pending);
+        log::info!("restorecon: cleared pending ksud label");
+    }
     restore_syscon_if_unlabeled(defs::MODULE_DIR)?;
     Ok(())
 }
