diff --git a/kernel/Kbuild b/kernel/Kbuild
index 19fa298..ffd127e 100644
--- a/kernel/Kbuild
+++ b/kernel/Kbuild
@@ -152,7 +152,10 @@ KERNEL_GIT_ROOT := $(shell cd $(srctree) && $(GIT) rev-parse --show-toplevel 2>/
 ifneq ($(GIT_ROOT),$(KERNEL_GIT_ROOT))
 # Only set version if it's a different repo from kernel
 $(shell cd $(GIT_ROOT) && [ -f .git/shallow ] && $(GIT) fetch --unshallow 2>/dev/null || true)
+# MapleSU: 允外部钉死 KSU_GIT_VERSION（浅克隆时 rev-list 数偏小，版本号会倒退）
+ifndef KSU_GIT_VERSION
 KSU_GIT_VERSION := $(shell cd $(GIT_ROOT) && $(GIT) rev-list --count HEAD 2>/dev/null)
+endif
 KSU_GIT_VERSION_VALID := 1
 $(info -- KernelSU: Git repo detected at $(GIT_ROOT))
 endif
@@ -163,7 +166,16 @@ endif
 
 
 # Calculate version if git version is available
-ifdef KSU_GIT_VERSION_VALID
+#
+# ── MapleSU：发布构建必须钉死内核版本号（03-ksu-contract §0.1 版本号陷阱）──────
+# DDK 容器只挂 kernel/，没有 .git → KSU_GIT_VERSION_VALID 不会被定义 →
+# 直接落到最后的 else，KSU_VERSION 变成 16（比线上倒退三万）。
+# 发布流水线显式传：-e KSU_VERSION_PIN=32650
+ifdef KSU_VERSION_PIN
+$(eval KSU_VERSION=$(KSU_VERSION_PIN))
+$(info -- KernelSU version (pinned by KSU_VERSION_PIN): $(KSU_VERSION))
+ccflags-y += -DKSU_VERSION=$(KSU_VERSION)
+else ifdef KSU_GIT_VERSION_VALID
 # ksu_version: major * 10000 + git version + 200 for historical reasons
 $(eval KSU_VERSION=$(shell expr 30000 + $(KSU_GIT_VERSION)))
 $(info -- KernelSU version: $(KSU_VERSION))
@@ -179,13 +191,31 @@ $(info -- KSU_NEW_DCACHE_FLUSH: $(KSU_NEW_DCACHE_FLUSH))
 
 KSU_IS_PR_BUILD ?= 0
 ifeq ($(KSU_IS_PR_BUILD),0)
-KSU_PACKAGE_NAME ?= me.weishu.kernelsu
+KSU_PACKAGE_NAME ?= dev.maplesu.manager
 else
-KSU_PACKAGE_NAME ?= me.weishu.kernelsu.pr
+KSU_PACKAGE_NAME ?= dev.maplesu.manager.pr
 endif
+# TODO(release): 下面两个默认值仍是上游占位（绝不冒充我方指纹）。
+# 发布流水线必须显式 -e KSU_EXPECTED_SIZE=<DER 长度> -e KSU_EXPECTED_HASH=<cert sha256>。
 KSU_EXPECTED_SIZE ?= 0x033b
 KSU_EXPECTED_HASH ?= c371061b19d8c7d7d6133c6a9bafe198fa944e50c1b31c9d8daa8d7f1fc2d2d6
 
+#
+# ── 管理器世代闸门（03 分册 §2.2.4）─────────────────────────────────────────
+# 认主除签名外还要求 APK 自带 `assets/ksu_manager_gen<N>`，且 N >= 本值。
+# 「再断一代」= 这里 +1，并同批发一版带 assets/ksu_manager_gen<N+1> 的管理器。
+ifndef KSU_MANAGER_MIN_GEN
+KSU_MANAGER_MIN_GEN := 2
+endif
+$(info -- KernelSU manager generation gate: KSU_MANAGER_MIN_GEN=$(KSU_MANAGER_MIN_GEN))
+ccflags-y += -DKSU_MANAGER_MIN_GEN=$(KSU_MANAGER_MIN_GEN)
+
+# 可选的双重校验（包名 + 证书 + gen），发布流水线传 -e KSU_MANAGER_PACKAGE=...
+# 注：0005 只落地「证书 + gen」两重；包名校验需要额外路径解析，见 manifest.todos。
+ifdef KSU_MANAGER_PACKAGE
+ccflags-y += -DKSU_MANAGER_PACKAGE=\"$(KSU_MANAGER_PACKAGE)\"
+endif
+
 $(info -- KernelSU Manager package name: $(KSU_PACKAGE_NAME))
 $(info -- KernelSU Manager signature size: $(KSU_EXPECTED_SIZE))
 $(info -- KernelSU Manager signature hash: $(KSU_EXPECTED_HASH))
