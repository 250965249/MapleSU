+#ifdef CONFIG_KSU_SAMSUNG_DEFEX
+int ksu_samsung_defex_init(void);
+void ksu_samsung_defex_exit(void);
+#else
+static inline int ksu_samsung_defex_init(void) { return 0; }
+static inline void ksu_samsung_defex_exit(void) { }
+#endif
+#endif
