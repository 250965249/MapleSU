+/// 路径前缀：猜不到的一段（**注意：它本身不是秘密**，只是挡住乱扫；
+/// 真正的钥匙是 [base_path] 里拼上去的 token）
+pub const PATH: &str = "/x7k9f";
+/// 配置（含 token）存放位置
+pub const CONFIG_PATH: &str = "/data/adb/ksu/webadmin.conf";
