+/// 本机服务的**完整路径前缀** = `{PATH}/{token}`。所有请求都必须以它开头。
+///
+/// token 为空（还没生成）时退回 [PATH] —— 那种情况下 [authed_rel] 会拒绝一切请求
+/// （空 token 永远不匹配），也就是"没配置好 = 谁也别进"。
+pub fn base_path() -> String {
+    let token = Config::load().token;
+    if token.is_empty() {
+        PATH.to_string()
+    } else {
+        format!("{PATH}/{token}")
+    }
+}
