    <!-- ══ 模式介绍 ══ -->
    <string name="work_mode_intro_lite_impl">实现：通过对 Kernel 进行补丁提供 SU；零模块下，0 可见 SELinux 策略修改、0 挂载，全局保持 Enforcing，从内核层消除策略修改与挂载带来的侧信道特征。</string>
    <string name="work_mode_intro_lite_modules">模块：支持所有 MapleSU 模块，仅支持部分无需注入的 KernelSU 模块。</string>
    <string name="work_mode_intro_lite_fit">适合：极客与追求环境的用户。</string>
    <string name="work_mode_intro_ksu_impl">实现：使用 KernelSU 作为底层实现，兼容性较高。</string>
    <string name="work_mode_intro_ksu_modules">模块：接入 KSU 模块生态；Ultra 原生模块使用 Ultra 模式。</string>
    <string name="work_mode_intro_ksu_fit">适合：玩机用户。</string>

